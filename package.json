{
  "name": "chela",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "check:ui": "tsc -p native/frontend",
    "dev": "npm run shell:dev",
    "dev:web": "vite native/frontend --config native/frontend/vite.config.ts --host 127.0.0.1",
    "build": "npm run shell:build",
    "shell:frontend": "vite build native/frontend --config native/frontend/vite.config.ts",
    "shell:agent": "node native/scripts/build-agent.mjs",
    "shell:dev": "npm run shell:agent && npm run shell:frontend && go -C native build -o bin/Chela-dev.exe . && native/bin/Chela-dev.exe",
    "shell:build": "npm run shell:agent && npm run shell:frontend && go -C native build -ldflags=-H=windowsgui -o bin/Chela.exe ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-mcp": "^1.5.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
